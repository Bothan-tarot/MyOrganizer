{
  "name": "myorganizer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1",
    "wrangler": "^4.159.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export -p web && node scripts/web-shells.js && workbox generateSW workbox-config.js",
    "deploy:web": "npm run build:web && wrangler deploy",
    "dev:worker": "npm run build:web && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "private": true
}
