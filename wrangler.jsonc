{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myorganizer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    // Produced by `npm run build:web`
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs get the app shell; Expo Router shows its own "not found" screen
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  // TMDB_TOKEN is a secret: `npx wrangler secret put TMDB_TOKEN` (and .dev.vars locally)
  "observability": { "enabled": true }
}
